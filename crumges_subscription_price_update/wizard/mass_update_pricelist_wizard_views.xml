<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mass_update_pricelist_wizard_form" model="ir.ui.view">
        <field name="name">mass.update.pricelist.wizard.form</field>
        <field name="model">mass.update.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update Pricelist">
                <group>
                    <field name="pricelist_id"/>
                    <field name="sale_order_ids" invisible="1"/>
                </group>
                <footer>
                    <button string="Update" name="action_update_pricelist" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mass_update_pricelist" model="ir.actions.act_window">
        <field name="name">Mass Update Pricelist</field>
        <field name="res_model">mass.update.pricelist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>