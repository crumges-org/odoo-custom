<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_recalculate" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.recalculate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_quotation_send" position="before">
                <field name="has_price_difference" invisible="1"/>
                <button name="action_open_recalculate_prices_wizard" 
                        string="Update Prices" 
                        type="object" 
                        class="oe_highlight"
                        invisible="not has_price_difference"/>
            </button>
        </field>
    </record>
</odoo>