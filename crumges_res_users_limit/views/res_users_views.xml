<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_tree_with_dashboard" model="ir.ui.view">
        <field name="name">res.users.tree.with.dashboard</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">user_limit_dashboard_tree</attribute>
            </xpath>
        </field>
    </record>
</odoo>
