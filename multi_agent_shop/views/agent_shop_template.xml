<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="agent_shop_template" name="Agent Shop Template">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12">
                            <h1>Multi Agent Shop</h1>
                            <p>Selecciona un cliente para realizar la compra</p>
                            
                            <div class="card">
                                <div class="card-body">
                                    <form method="POST" action="/agent/shop/customer">
                                        <div class="form-group">
                                            <label for="customer">Cliente:</label>
                                            <select class="form-control" id="customer" name="customer" required>
                                                <option value="">-- Selecciona un cliente --</option>
                                                <t t-foreach="customer_ids" t-as="customer">
                                                    <option t-att-value="customer.id" t-esc="customer.name"/>
                                                </t>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-shopping-cart"/> Ir a Comprar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>