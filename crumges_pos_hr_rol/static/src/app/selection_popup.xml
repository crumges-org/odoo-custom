<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="crumges_pos_hr_rol.SelectionPopup" t-inherit="point_of_sale.SelectionPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('flex-column')]/span[1]" position="replace">
            <span>
                <t t-if="item.item and item.item.role_emoji" t-esc="item.item.role_emoji + ' '"/>
                <t t-esc="item.label" />
            </span>
        </xpath>
    </t>
</templates>
