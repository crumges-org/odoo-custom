<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pos_multimedia_website_sale" model="ir.ui.view">
        <field name="name">product.template.form.pos.multimedia.website.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="crumges_pos_multimedia.product_template_form_view_pos_multimedia"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pos_multimedia']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_image_form_inherit_pos_multimedia" model="ir.ui.view">
        <field name="name">product.image.view.form.inherit.pos.multimedia</field>
        <field name="model">product.image</field>
        <field name="inherit_id" ref="website_sale.view_product_image_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="before">
                <field name="image_filename" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="filename">image_filename</attribute>
            </xpath>
        </field>
    </record>
</odoo>
