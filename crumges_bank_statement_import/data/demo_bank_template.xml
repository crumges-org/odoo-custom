<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Formato de Ejemplo 1: 3 Columnas (Monto Único) -->
        <record id="demo_bank_template_single" model="bank.statement.template">
            <field name="name">Banco Ejemplo (Una Columna Importe)</field>
            <field name="start_row">2</field>
            <field name="amount_type">single</field>
            <field name="col_date">A</field>
            <field name="col_label">B</field>
            <field name="col_amount">C</field>
            <field name="col_balance">D</field>
        </record>

        <!-- Formato de Ejemplo 2: 4 Columnas (Débito y Crédito) -->
        <record id="demo_bank_template_split" model="bank.statement.template">
            <field name="name">Banco Ejemplo (Débito/Crédito Separado)</field>
            <field name="start_row">5</field>
            <field name="amount_type">split</field>
            <field name="col_date">A</field>
            <field name="col_label">C</field>
            <field name="col_debit">D</field>
            <field name="col_credit">E</field>
            <field name="col_balance">F</field>
        </record>
    </data>
</odoo>
