<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_import_history_list" model="ir.ui.view">
        <field name="name">bank.statement.import.history.list</field>
        <field name="model">bank.statement.import.history</field>
        <field name="arch" type="xml">
            <list string="Historial de Importaciones">
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="bank_id"/>
                <field name="journal_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="line_count" string="Líneas Creadas"/>
            </list>
        </field>
    </record>

    <record id="view_bank_statement_import_history_form" model="ir.ui.view">
        <field name="name">bank.statement.import.history.form</field>
        <field name="model">bank.statement.import.history</field>
        <field name="arch" type="xml">
            <form string="Historial de Importación">
                <header>
                    <button name="action_delete_import" type="object" class="btn btn-danger" string="Eliminar Importación" invisible="not can_delete" confirm="¿Está seguro de eliminar esta importación? Se borrarán todas las líneas que NO hayan sido conciliadas."/>
                </header>
                <sheet>
                    <field name="can_delete" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list" invisible="line_count == 0">
                            <field name="line_count" widget="statinfo" string="Líneas Importadas"/>
                        </button>
                        <button name="action_view_reconciled_lines" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="reconciled_count == 0">
                            <field name="reconciled_count" widget="statinfo" string="Conciliadas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="create_date"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_data" filename="filename" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bank_statement_import_history" model="ir.actions.act_window">
        <field name="name">Historial de Importaciones</field>
        <field name="res_model">bank.statement.import.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
