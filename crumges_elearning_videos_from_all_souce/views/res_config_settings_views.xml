<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crumges.video</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_slides.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_slides_selection_settings']" position="after">
                <block title="Zoom Integration" id="crumges_zoom_settings">
                    <setting help="Configure Zoom API Keys for meeting integration">
                        <field name="zoom_api_key" placeholder="Zoom SDK Key"/>
                        <field name="zoom_api_secret" placeholder="Zoom SDK Secret"/>
                        <div class="mt8">
                            <a href="https://marketplace.zoom.us/" target="_blank">
                                <i class="oi oi-arrow-right"/> Get your keys on Zoom Marketplace
                            </a>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
