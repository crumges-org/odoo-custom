<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_brand" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.brand</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_print_brand" string="Imprimir Marca en el Recibo" help="Muestra el nombre de la marca en las líneas de productos del recibo de venta y en el carrito.">
                    <field name="pos_iface_print_brand"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
