<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_query_manager">
            <field name="name">Gestor de Consultas Odoo</field>
            <field name="description">Permisos para gestionar y ejecutar consultas SQL desde la interfaz</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo Ejecutor -->
        <record id="group_query_manager_executor" model="res.groups">
            <field name="name">Ejecutor de Consultas (Solo Lectura/Ejecución segura)</field>
            <field name="category_id" ref="module_category_query_manager"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">El usuario solo puede ver las consultas y ejecutar aquellas que sean de lectura (SELECT).</field>
        </record>

        <!-- Grupo Administrador -->
        <record id="group_query_manager_admin" model="res.groups">
            <field name="name">Administrador de Consultas (CRUD Total)</field>
            <field name="category_id" ref="module_category_query_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_query_manager_executor'))]"/>
            <field name="comment">El usuario puede crear, editar, eliminar y ejecutar cualquier tipo de consulta SQL.</field>
        </record>

    </data>
</odoo>
