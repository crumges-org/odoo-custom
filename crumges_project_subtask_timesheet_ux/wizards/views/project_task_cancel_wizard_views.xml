<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_cancel_wizard_form" model="ir.ui.view">
        <field name="name">project.task.cancel.wizard.form</field>
        <field name="model">project.task.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Cancelación">
                <field name="message" widget="html" nolabel="1"/>
                <footer>
                    <button string="Continuar" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" type="object" name="action_cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>