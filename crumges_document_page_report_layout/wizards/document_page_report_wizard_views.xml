<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_page_report_wizard_form" model="ir.ui.view">
        <field name="name">document.page.report.wizard.form</field>
        <field name="model">document.page.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print with Template">
                <group>
                    <field name="report_config_id" widget="selection"/>
                    <field name="document_page_ids" widget="many2many_tags" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print (Browser)" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_page_report_wizard" model="ir.actions.act_window">
        <field name="name">Print with Template</field>
        <field name="res_model">document.page.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="document_page.model_document_page"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
