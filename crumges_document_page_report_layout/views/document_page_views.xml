<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_page_form_inherit_report_layout" model="ir.ui.view">
        <field name="name">document.page.form.inherit.report.layout</field>
        <field name="model">document.page</field>
        <field name="inherit_id" ref="document_page.view_wiki_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_document_page_report_wizard)d" string="Print with Template" type="action" class="oe_highlight" icon="fa-print" context="{'default_document_page_ids': [active_id]}"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
