<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista de formulario para product.template -->
    <record id="view_product_template_form_inherited" model="ir.ui.view">
        <field name="name">product.template.form.inherited.upsell</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Venta Adicional" name="upsell_config" 
                      invisible="not is_upsell_category">
                    <group>
                        <group>
                            <field name="is_upsell_category"/>
                            <field name="upsell_mode" 
                                   required="is_upsell_category"
                                   invisible="not is_upsell_category"/>
                        </group>
                        <group invisible="upsell_mode != 'prepaid_consumption'">
                            <field name="parent_service_product_id" 
                                   required="upsell_mode == 'prepaid_consumption'"
                                   options="{'no_create': True}"/>
                            <field name="dummy_product_id" 
                                   required="upsell_mode == 'prepaid_consumption'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <separator string="Información" invisible="not is_upsell_category"/>
                    <div class="alert alert-info" role="alert" invisible="not is_upsell_category">
                        <p><strong>Modos de Venta Adicional:</strong></p>
                        <ul>
                            <li><strong>Venta Adicional Directa:</strong> Crea nueva tarea y línea facturable</li>
                            <li><strong>Consumo Pre-contratado:</strong> Crea subtarea en bolsa de horas existente</li>
                        </ul>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    
    <!-- Vista de lista para productos -->
    <record id="view_product_template_tree_inherited" model="ir.ui.view">
        <field name="name">product.template.tree.inherited.upsell</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="is_upsell_category" optional="show"/>
                <field name="upsell_mode" optional="hide"/>
            </xpath>
        </field>
    </record>
    
</odoo>