<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View upsell.category View List -->
    <record id="view_upsell_category_list" model="ir.ui.view">
        <field name="name">view.upsell.category.list</field>
        <field name="model">upsell.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <!-- View upsell.category form -->
    <record id="view_upsell_category_form" model="ir.ui.view">
        <field name="name">view.upsell.category.form</field>
        <field name="model">upsell.category</field>
        <field name="arch" type="xml">
            <form string="Upsell Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="product_id" 
                            readonly="1"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View upsell.category search -->
    <record id="view_upsell_category_search" model="ir.ui.view">
        <field name="name">view.upsell.category.search</field>
        <field name="model">upsell.category</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action upsell.category -->
    <record id="action_upsell_category" model="ir.actions.act_window">
        <field name="name">Upsell Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upsell.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Upsell Category.
            </p>
        </field>
    </record>
    
    <menuitem
        id="menu_upsell_category"
        name="Upsell Category"
        action="action_upsell_category"
        parent="helpdesk.helpdesk_menu_config"
        sequence="10" />
</odoo>
