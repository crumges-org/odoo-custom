<?xml version="1.0" encoding="utf-8"?>
<odoo>
      
    <!-- Vista del formulario de helpdesk.ticket -->
    <record id="view_helpdesk_ticket_form_inherited" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.upsell</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra_info']" position="after">
                <page string="Venta Adicional" name="upsell" invisible="not has_upsell">
                    <group>
                        <field name="has_upsell" invisible="1"/>
                        <field name="upsell_product_id" readonly="1"/>
                        <field name="subscription_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>