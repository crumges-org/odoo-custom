<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default bot source names configuration -->
        <record id="default_bot_source_names" model="ir.config_parameter">
            <field name="key">crm_lead_force_lead_from_bot.bot_source_names</field>
            <field name="value">Bot Conversacional,Script Bot,Chatbot</field>
        </record>

        <!-- Enable bot detection by default -->
        <record id="bot_detection_enabled" model="ir.config_parameter">
            <field name="key">crm_lead_force_lead_from_bot.detection_enabled</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>
