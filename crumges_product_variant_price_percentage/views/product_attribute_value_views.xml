<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_attribute_value_view_form_inherit_percentage" model="ir.ui.view">
        <field name="name">product.template.attribute.value.view.form.inherit.percentage</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="variant_price_percentage"/>
            </field>
        </field>
    </record>

    <record id="product_template_attribute_value_view_tree_inherit_percentage" model="ir.ui.view">
        <field name="name">product.template.attribute.value.view.tree.inherit.percentage</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="variant_price_percentage"/>
            </field>
        </field>
    </record>
</odoo>
