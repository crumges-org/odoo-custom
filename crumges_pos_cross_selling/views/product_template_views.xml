<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pos_cross_selling" model="ir.ui.view">
        <field name="name">product.template.form.pos.cross.selling</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='upsell']" position="inside">
                <field name="crumges_pos_alternative_product_ids" widget="many2many_tags" invisible="not available_in_pos"/>
                <field name="crumges_pos_accessory_product_ids" widget="many2many_tags" invisible="not available_in_pos"/>
            </xpath>
        </field>
    </record>
</odoo>
