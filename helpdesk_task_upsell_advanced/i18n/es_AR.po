#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid ""
"<b>Automatic Detection:</b> The system will find or create \n"
"                            the parent task automatically."
msgstr ""
"<b>Detección automática:</b> El sistema encontrará o creará \n"
"                            la tarea principal automáticamente."

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid ""
"<b>Parent Product:</b> Where hours accumulate and get invoiced \n"
"                            (e.g., \"GPS Installations - 50 hours\")."
msgstr ""
"<b>Producto principal</b> Donde se acumulan las horas y se facturan \n"
"                            (por ejemplo, \"Instalaciones GPS - 50 horas\")."

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid ""
"<b>Product (above):</b> Used for informative lines in the order \n"
"                            (e.g., \"Installation: ABC-123\"). These lines don't invoice."
msgstr ""
"<b>Producto (comoding o dummy):</b> Se utiliza para líneas informativas en el pedido \n"
"                            (p. ej., \"Instalación: ABC-123\"). Estas líneas no se facturan."

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid ""
"<b>Task Structure:</b> Creates subtasks under a parent task. \n"
"                            Hours from subtasks accumulate in the parent."
msgstr ""
"<b>Estructura de la tarea:</b> Crea subtareas dentro de una tarea principal. \n"
"                            Las horas de las subtareas se acumulan en la tarea principal."

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid ""
"<i class=\"fa fa-lightbulb-o\"/> \n"
"                        <b>Example:</b> Category \"Installation\" → Product \"Installation\" "
"(info only) \n"
"                        + Parent Product \"GPS Installations\" (hour accumulator)"
msgstr ""
"<i class=\"fa fa-lightbulb-o\"/> \n"
"                        <b>Ejemplo:</b> Categoría \"Instalación\" → Producto \"Instalación\" "
"(solo información) \n"
"                        + Producto principal \"Instalaciones GPS\" (acumulador de horas)"

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.view_upsell_category_form_advanced
msgid "<strong>How Parent Task Hierarchy Works:</strong>"
msgstr "<strong>Cómo funciona la jerarquía de tareas principales:</strong>"

