#. module: helpdesk_task_upsell_advanced
#. odoo-python
#: code:addons/helpdesk_task_upsell_advanced/wizards/helpdesk_create_fsm_task.py:0
msgid ""
"Operation Reference is required.\n"
"\n"
"Please provide an identifier for this operation (e.g., vehicle plate, machine ID, serial number)."
msgstr ""
"Se requiere referencia de la operación..\n"
"\n"
"Por favor, proporcione un identificador para esta operación (p. ej., matrícula del vehículo, ID "
"de la máquina, número de serie)."

#. module: helpdesk_task_upsell_advanced
#: model_terms:ir.ui.view,arch_db:helpdesk_task_upsell_advanced.create_fsm_task_view_form_advanced_fields
