<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add field for full task description in wizard -->
    <record id="create_fsm_task_view_form_advanced_description" model="ir.ui.view">
        <field name="name">Create FSM Task - Advanced Description Field</field>
        <field name="model">helpdesk.create.fsm.task</field>
        <field name="inherit_id" ref="helpdesk_task_upsell.create_fsm_task_view_form_inherited"/>
        <field name="arch" type="xml">
            
            <!-- Add task_full_description field after qty -->
            <xpath expr="//field[@name='qty']" position="after">
                <field name="task_full_description"
                    invisible="not for_upsell or not upsell_category_id.use_parent_task"
                    placeholder="Optional: Add detailed instructions or notes for the technician..."
                    colspan="2"/>
            </xpath>
            
        </field>
    </record>

</odoo>
