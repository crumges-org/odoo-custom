<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crumges.pos.clean.empty.orders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='multiple_prices_setting']" position="after">
                <setting help="Permite limpiar órdenes en 0 en la pantalla de tickets.">
                    <field name="pos_iface_clean_empty_orders" />
                    <div class="content-group" invisible="not pos_iface_clean_empty_orders">
                        <div class="row mt16">
                            <label string="Tiempo de gracia (segundos)" for="pos_clean_empty_orders_time_limit" class="col-lg-5 o_light_label" />
                            <field name="pos_clean_empty_orders_time_limit" class="col-lg-3"/>
                        </div>
                        <div class="text-muted mt8">
                            Las órdenes creadas hace menos de este tiempo no serán eliminadas.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
