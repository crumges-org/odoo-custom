<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_upsell_warning_wizard_form" model="ir.ui.view">
        <field name="name">crumges.upsell.warning.wizard.form</field>
        <field name="model">crumges.upsell.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Upsell Warning">
                <group>
                    <field name="message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm_upsell" string="Sí, crear igualmente" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
