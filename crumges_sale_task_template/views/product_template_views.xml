<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_task_template" model="ir.ui.view">
        <field name="name">product.template.form.inherit.task.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field 
                    name="task_template_id"
                    invisible="service_tracking not in ['task_global_project', 'task_in_project']"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
            </field>
        </field>
    </record>

</odoo>