<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Form View Extension -->
    <record id="product_product_form_view_mrp_potential" model="ir.ui.view">
        <field name="name">product.product.form.mrp.potential</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_product_forecast_report']" position="after">
                <button class="oe_stat_button" name="action_view_mrp_bom_structure"
                        type="object" icon="fa-industry"
                        invisible="not mrp_has_bom">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="mrp_potential_qty" widget="statinfo" nolabel="1"/>
                            <field name="mrp_has_bom" invisible="1"/>
                        </span>
                        <span class="o_stat_text">Potential</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
    


    <!-- Product Template Form View Extension -->
    <record id="product_template_form_view_mrp_potential" model="ir.ui.view">
        <field name="name">product.template.form.mrp.potential</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="after">
                <button class="oe_stat_button" name="action_view_mrp_bom_structure"
                        type="object" icon="fa-industry"
                        invisible="not mrp_has_bom">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="mrp_potential_qty" widget="statinfo" nolabel="1"/>
                            <field name="mrp_has_bom" invisible="1"/>
                        </span>
                        <span class="o_stat_text">Potential</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Product Template Kanban View Extension -->
    <record id="product_template_kanban_view_mrp_potential" model="ir.ui.view">
        <field name="name">product.template.kanban.mrp.potential</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <field name="mrp_has_bom" invisible="1"/>
                <div t-if="record.mrp_has_bom.raw_value" class="badge rounded-pill text-bg-info">
                    <i class="fa fa-industry me-1"/>
                    Potential: <field name="mrp_potential_qty"/>
                </div>
            </xpath>
        </field>
    </record>
    
    <!-- Kanban View Extension -->
    <record id="product_product_kanban_view_mrp_potential" model="ir.ui.view">
        <field name="name">product.product.kanban.mrp.potential</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <field name="mrp_has_bom" invisible="1"/>
                <div t-if="record.mrp_has_bom.raw_value" class="badge rounded-pill text-bg-info">
                    <i class="fa fa-industry me-1"/>
                    Potential: <field name="mrp_potential_qty"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
