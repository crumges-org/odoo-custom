<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add subscription fields to order lines tree view -->
    <record id="view_order_line_tree_subscription_qty" model="ir.ui.view">
        <field name="name">sale.order.line.tree.subscription.qty</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            
            <field name="product_uom_qty" position="after">
                <field name="is_subscription_line" column_invisible="True"/>
                <field name="calculated_subscription_qty" 
                       optional="hide"
                       column_invisible="not parent.has_subscription_lines"
                       readonly="1"/>
                <field name="subscription_qty_needs_sync" 
                       widget="boolean_toggle"
                       column_invisible="not parent.has_subscription_lines"
                       readonly="1"/>
            </field>
            
        </field>
    </record>

    <!-- Add sync button to form view -->
    <record id="view_order_form_subscription_sync_button" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.sync</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add button in header -->
            <button name="action_confirm" position="before">
                <button name="%(action_sync_all_subscriptions)d" 
                        type="action" 
                        string="Sync Subscriptions"
                        class="btn-warning"
                        invisible="not has_subscription_lines or state not in ['draft', 'sent']"
                        help="Update subscription quantities based on delivered services"/>
            </button>
            
        </field>
    </record>

</odoo>