<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_order_form_subscription_info" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.info</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Campos invisibles para cálculos -->
            <field name="partner_id" position="after">
                <field name="has_subscription_lines" invisible="1"/>
                <field name="has_negative_subscription" invisible="1"/>
                <field name="negative_subscription_message" invisible="1"/>
            </field>
            
            <!-- Advertencia en la parte superior -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" 
                     invisible="not has_negative_subscription"
                     style="margin-bottom: 0;">
                    <field name="negative_subscription_message" 
                           nolabel="1" 
                           readonly="1"
                           widget="html"/>
                </div>
            </xpath>
            
            <!-- Tab de información -->
            <xpath expr="//notebook" position="inside">
                <page string="Subscription Info" 
                      name="subscription_info"
                      invisible="not has_subscription_lines">
                    <group>
                        <div class="alert alert-info" role="alert">
                            <p><strong>📊 Automatic Subscription Management</strong></p>
                            <p>• This order contains automatically managed subscription products.</p>
                            <p>• Subscription quantities update automatically when service deliveries are validated.</p>
                            <p>• Formula: Subscription Qty = Installations Delivered - Uninstallations Delivered</p>
                        </div>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>

</odoo>