<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add subscription info tab to sale.order -->
    <record id="view_order_form_subscription_tab" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.tab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <field name="partner_id" position="after">
                <field name="has_subscription_lines" invisible="1"/>
                <field name="has_negative_subscription" invisible="1"/>
                <field name="negative_subscription_message" invisible="1"/>
            </field>
            
            <!-- ⭐ ADVERTENCIA VISUAL en la parte superior de la orden -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" 
                     invisible="not has_negative_subscription"
                     style="margin-bottom: 0px;">
                    <field name="negative_subscription_message" 
                           nolabel="1" 
                           readonly="1"
                           widget="html"/>
                </div>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Subscription Info" 
                      name="subscription_info"
                      invisible="not has_subscription_lines">
                    
                    <group string="Active Subscriptions">
                        <p>This order contains automatically managed subscription products.</p>
                    </group>
                    
                </page>
            </xpath>
            
        </field>
    </record>

</odoo>