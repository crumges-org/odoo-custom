<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_purpose_tree" model="ir.ui.view">
        <field name="name">task.purpose.list</field>
        <field name="model">task.purpose</field>
        <field name="arch" type="xml">
            <list string="Task Purposes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_task_purpose_form" model="ir.ui.view">
        <field name="name">task.purpose.form</field>
        <field name="model">task.purpose</field>
        <field name="arch" type="xml">
            <form string="Task Purpose">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_purpose" model="ir.actions.act_window">
        <field name="name">Task Purposes</field>
        <field name="res_model">task.purpose</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Define a new Task Purpose
          </p>
        </field>
    </record>

    <menuitem id="menu_task_purpose"
              name="Task Purposes"
              parent="project.menu_project_config"
              action="action_task_purpose"
              sequence="20"/>
</odoo>
