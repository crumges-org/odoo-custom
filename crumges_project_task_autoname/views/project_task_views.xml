<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_autoname" model="ir.ui.view">
        <field name="name">project.task.form.autoname</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">name_type == 'auto_composed'</attribute>
            </xpath>

            <xpath expr="//notebook" position="before">
                 <div class="alert alert-info" role="status" invisible="name_type == 'manual'">
                    Task name is auto-generated based on ID, Purpose and Info.
                </div>

                <group>
                    <group name="task_naming" string="Task Naming" invisible="child_ids">
                        <!-- Hide Naming Option if task has subtasks (child_ids is not empty) -->
                        <field name="name_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="use_sale_line_product" invisible="name_type == 'manual'"/>
                        
                        <!-- Fields always visible (unless parent), required if Auto Name selected -->
                        <field name="purpose_id" required="name_type == 'auto_composed' and not use_sale_line_product" invisible="use_sale_line_product"/>
                        <field name="additional_info" required="name_type == 'auto_composed'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
