<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_role_list" model="ir.ui.view">
        <field name="name">hr.employee.role.list</field>
        <field name="model">hr.employee.role</field>
        <field name="arch" type="xml">
            <list string="Roles de Empleados">
                <field name="role_emoji" widget="char"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_role_form" model="ir.ui.view">
        <field name="name">hr.employee.role.form</field>
        <field name="model">hr.employee.role</field>
        <field name="arch" type="xml">
            <form string="Rol de Empleado">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Empleados"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="d-flex align-items-center gap-2">
                            <h1 style="width: 80px;">
                                <field name="role_emoji" widget="emoji" placeholder="☕"/>
                            </h1>
                            <h1>
                                <field name="name" placeholder="Ej: Cafetería"/>
                            </h1>
                        </div>
                    </div>
                    <group>
                        <field name="description" placeholder="Notas sobre el rol..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit Employee Kanban View to add Role -->
    <record id="hr_kanban_view_employees_inherit_role" model="ir.ui.view">
        <field name="name">hr.employee.kanban.inherit.role</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="role_id"/>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="after">
                <div t-if="record.role_id.raw_value" class="mt-1">
                    <span class="badge rounded-pill text-bg-light border" title="Rol del Empleado">
                        <field name="role_emoji"/> <field name="role_name"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee Search View to add Group By Role -->
    <record id="view_employee_filter_inherit_role" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.role</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_job']" position="after">
                <filter name="group_role" string="Rol del Empleado" domain="[]" context="{'group_by': 'role_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_hr_employee_role" model="ir.actions.act_window">
        <field name="name">Roles de Empleados</field>
        <field name="res_model">hr.employee.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_employee_role"
              name="Roles de Empleados"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_employee_role"
              sequence="5"/>
</odoo>
