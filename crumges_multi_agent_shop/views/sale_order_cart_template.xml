<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_info_section" name="Customer Purchase Info">
        <t t-if="request.session.get('agent_customer_id')">
            <div class="customer-purchase-info mb-3 pb-3 border-bottom">
                <div class="row">
                    <div class="col-12">
                        <small class="text-muted d-block mb-2">
                            <i class="fa fa-clipboard me-2"/>
                            <strong>Compra a nombre de:</strong>
                        </small>
                        <p class="mb-0">
                            <strong t-esc="request.session.get('agent_customer_name')"/>
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Alert Warning -->
            <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
                <div class="d-flex align-items-start">
                    <i class="fa fa-info-circle me-3 mt-1" style="font-size: 1.25rem; color: #0c5460;"/>
                    <div>
                        <strong>Recordatorio:</strong>
                        <p class="mb-0 mt-2 small">
                            Completa esta compra antes de cambiar de cliente. Si regresas al menú de selección de cliente, 
                            el carrito actual será descartado y perderás todos los productos agregados.
                        </p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="website_sale_cart_inherit" inherit_id="website_sale.cart" priority="16">
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="before">
            <t t-call="crumges_multi_agent_shop.customer_info_section"/>
        </xpath>
    </template>
</odoo>