<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_agent" name="Portal My Home : Agent Shop" inherit_id="portal.portal_my_home" priority="90">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="request.env.user.partner_id.is_agent">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Tienda Multi Agente</t>
                    <t t-set="url" t-value="'/agent/shop'"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
