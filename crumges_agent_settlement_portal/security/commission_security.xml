<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla para ver solo liquidaciones propias del portal -->
        <record id="commission_settlement_portal_rule" model="ir.rule">
            <field name="name">Liquidaciones de Comisión del Agente en Portal</field>
            <field name="model_id" ref="commission_oca.model_commission_settlement"/>
            <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla para ver solo líneas de liquidación propias -->
        <record id="commission_settlement_line_portal_rule" model="ir.rule">
            <field name="name">Líneas de Liquidación del Agente en Portal</field>
            <field name="model_id" ref="commission_oca.model_commission_settlement_line"/>
            <field name="domain_force">[('settlement_id.agent_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
