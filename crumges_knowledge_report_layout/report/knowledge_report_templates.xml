<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_knowledge_article">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <!-- Logic to fetch config -->
                <t t-set="report_config" t-value="None"/>
                <!-- 1. Check Wizard Context -->
                <t t-if="env.context.get('kn_report_layout_id')">
                    <t t-set="report_config" t-value="env['report.layout.config'].browse(env.context.get('kn_report_layout_id'))"/>
                </t>
                <!-- 2. Check Article Config (if single doc) -->
                <t t-elif="doc.report_config_id and doc.use_custom_report_config">
                     <t t-set="report_config" t-value="doc.report_config_id"/>
                </t>

                <!-- Dynamic Styles -->
                <t t-if="report_config">
                    <style>
                        <t t-raw="report_config.get_css_variables()"/>
                    </style>
                </t>

                <div t-attf-class="page {{ report_config and ('k_layout_' + report_config.layout_style) or '' }}">
                    
                    <!-- Header -->
                    <t t-if="report_config and report_config.show_header">
                        <div class="row header mb-4">
                            <div class="col-12">
                                <t t-raw="report_config.header_content"/>
                            </div>
                        </div>
                    </t>
                    
                    <!-- Main Content -->
                    <div class="row">
                        <div class="col-12">
                            <!-- Title -->
                            <h1 t-field="doc.name" class="mb-4" style="color: var(--report-primary, #000);"/>
                            
                            <!-- Cover Image -->
                            <t t-if="doc.cover_image_id">
                                <div class="mb-4">
                                     <img t-att-src="image_data_uri(doc.cover_image_id.image_1920)" style="max-height: 300px; width: auto;"/>
                                </div>
                            </t>

                            <!-- Body -->
                            <div class="article_body">
                                <t t-raw="doc.body"/>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <t t-if="report_config and report_config.show_footer">
                        <div class="row footer mt-4 pt-2" style="border-top: 1px solid #ddd;">
                            <div class="col-12">
                                <t t-raw="report_config.footer_content"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
